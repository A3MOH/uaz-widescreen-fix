shader()
{//ps 1.1 gf3,
    ShaderQuality(2)
    cull("cw")
    sortweight("preblended")
    pass()
    {
        Pixelshader("Water.psh")

        tmu()
        {
            texture()
            {
                usermap(0)
                addressfunc("clamp", "clamp", "clamp")
            }

            texgen("projected")
        }

        !include("..\\Shaders\\__TerrainColormapSmall.mtt")

        !include("..\\Shaders\\__Clouds.mtt")

        blendfunc("inv_dest_alpha", "dest_alpha")
        depthfunc("lequal", 0)
        AlphaFunc("greater", 0)
    }
}

shader()
{
    ShaderQuality(1)
    cull("cw")
    sortweight("preblended")
    pass()
    {
        tmu()
        {
            texture()
            {
                usermap(0)
                addressfunc("clamp", "clamp", "clamp")
            }

            texgen("projected")
        }

        blendfunc("inv_dest_alpha", "dest_alpha")
        depthfunc("lequal", 0)
        AlphaFunc("greater", 0)
    }
}



