
shader()
{
    ShaderQuality(4)
    cull("cw")
    sortweight("preblended")
    pass()
    {

        Vertexshader("WaterRain.vsh")
        Pixelshader("WaterRain20.psh")

        tmu()
        {
            texture()
            {
                usermap(0)
                addressfunc("clamp", "clamp", "clamp")
            }
            texgen("projected")
        }
        tmu()
        {
            TexMtxDirPosScale(0, -1, 0, 0, 0, 0, 0.00026, 0.00026, 0.00026)
            TexMod("translate", "none", 0, 0, 0, "lin", 0, -0.011, 0)
            texture()
            {
                Image("NoiseA.dds")
                LODBias(-2)
            }
        }
        tmu()
        {
            TexMtxDirPosScale(0, -1, 0, 0, 0, 0, 0.0002, 0.0002, 0.0002)
            TexMod("translate", "lin", 0, 0.001, 0, "lin", 0, 0.01, 0)
            texture()
            {
                Image("NoiseA.dds")
                LODBias(-2)
            }
        }
        tmu()
        {
            TexMtxDirPosScale(0.866025, 0.5, 0.0, 0, 0, 0, 0.000015, 0.000015, 0.000015)
            TexMod("translate", "lin", 0, 0.02, 0, "lin", 0, 0.001, 0)
            texture()
            {
                Image(%cloudstexture)
            }
        }
        tmu()
        {
            texture()
            {
                Image(%colortexturesmall)
                addressfunc("clamp", "clamp", "clamp")
            }
        }
        tmu()
        {
            texture()
            {
                Image("SunFace.dds")
                addressfunc("clamp", "clamp", "clamp")
            }
        }
        tmu()
        {
            texture()
            {
                Image("RainRipples.dds")
            }
        }
        blendfunc("inv_dest_alpha", "dest_alpha")
        depthfunc("lequal", 0)
    }
}

