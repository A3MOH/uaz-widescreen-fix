regc4f( 5, %daycolor_r, %daycolor_g, %daycolor_b, %sunvisibility )
regc4f( 6, %raintime, %rainnow, 0.0, 0.0 )
regc4f( 7, %ambient_r, %ambient_g, %ambient_b, %ambient_a )

hlsl("

sampler2D	sReflection: register(s0);
sampler2D	sNoise1: register(s1);
sampler2D	sNoise2: register(s2);
sampler2D	sClouds: register(s3);
sampler2D	sLightmap: register(s4);
sampler2D	sSpecular: register(s5);
sampler2D	sRipples: register(s6);

const float4 DayColor : register(c5);
const float4 Rain : register(c6);
const float4 Ambient : register(c7);

#define NOISE_BEND		20.0
#define RIPPLE_BEND		0.06
#define RIPPLE_BRIGHT	0.25
#define RIPPLE_LAG		0.5

struct PS_INPUT
{
	float4	uvRefl : TEXCOORD0;
	float2	uvNoise1 : TEXCOORD1;
	float2	uvNoise2 : TEXCOORD2;
	float2	uvClouds : TEXCOORD3;
	float2	uvLightmap : TEXCOORD4;
	float2	uvSpec : TEXCOORD5;
	float4	uvRipple : TEXCOORD6;
};

float3 Ripple( float4 r, float t, float amount )
{
	float Drop = frac( r.a + t );
	float Wave = saturate( (Drop - 1 + r.r)*3 );
	float Ring = saturate( amount - Drop )*r.r*Wave*(1 - Wave)*4;
	return float3( (r.gb*2 - 1)*Ring, abs(Ring) );
}

float4 main( PS_INPUT i ): COLOR {

	float4 N1 = tex2D( sNoise1, i.uvNoise1 );
	float4 N2 = tex2D( sNoise2, i.uvNoise2 );
	half Clouds = 1 - tex2D( sClouds, i.uvClouds ).a;
	half LightA = tex2D( sLightmap, i.uvLightmap ).a;
	half SpecA = tex2D( sSpecular, i.uvSpec ).a;

	float3 Rip = Ripple( tex2D( sRipples, i.uvRipple.xy ), Rain.x, Rain.y )
	           + Ripple( tex2D( sRipples, i.uvRipple.zw ), Rain.x + RIPPLE_LAG, Rain.y );

	float4 uv = N1*N2*NOISE_BEND + i.uvRefl;
	uv.xy += Rip.xy*RIPPLE_BEND*i.uvRefl.w;
	float4 Refl = tex2Dproj( sReflection, uv );

	half Shadow = Clouds*LightA;
	half Light = saturate( Shadow*Ambient.b + Ambient.a );
	half4 Spec = SpecA*Shadow*Shadow*DayColor.a*DayColor;
	Spec *= 1 - saturate( N1.a + N2.a );

	Refl.a = 1 - Refl.a;
	float4 Color = saturate( Refl*Light + Spec );
	Color.rgb = saturate( Color.rgb + Rip.z*RIPPLE_BRIGHT*Light*DayColor.rgb );
	return Color;
}
")
