Weather("clear")
{
	DayTime(0, 6, "Night")
	DayTimeTrans(6, 8, "Night", "Dawn")
	DayTimeTrans(8, 10, "Dawn", "Day")
	DayTime(8, 17, "Day")
	DayTimeTrans(17, 19, "Day", "Dusk")
	DayTimeTrans(19, 21, "Dusk", "Night")
	DayTime(21, 24, "Night")
}

Weather("rainy")
{
	DayTime(0, 6, "NightRain")
	DayTimeTrans(6, 8, "NightRain", "DawnRain")
	DayTimeTrans(8, 10, "DawnRain", "DayRain")
	DayTime(8, 17, "DayRain")
	DayTimeTrans(17, 19, "DayRain", "DuskRain")
	DayTimeTrans(19, 21, "DuskRain", "NightRain")
	DayTime(21, 24, "NightRain")
	Rain(0.8, 0.5, 0.1) 
}

