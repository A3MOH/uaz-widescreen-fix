!include("../../Maps/Climate.def")

State("Day")
{
	//SKY COLOR, RGB = kolor nieba, A = Flag: Turn On/Off sun
	VarFloat("skycolor_r", 0.14)
	VarFloat("skycolor_g", 0.24)
	VarFloat("skycolor_b", 0.56)
	VarFloat("skycolor_a", 1.00)

	//DAY COLOR, RGB = Day (light) color, A = Flag: Turn On/Off lights
	VarFloat("daycolor_r", 1.00)
	VarFloat("daycolor_g", 0.95)
	VarFloat("daycolor_b", 0.85)
	VarFloat("daycolor_a", 0.00)

	//FOG COLOR, RGB = Fog color, A = Fog Far Factor
	VarFog("fogcolor_r", 0.68,
	"fogcolor_g", 0.78,
	"fogcolor_b", 0.82)
	VarFogFar( 1.00)

	//AMBIENT COLOR, RGB = Ambient color (MUL), A = Ambient power - inverted ambient (ADD)
	VarFloat("ambient_r", 0.70)
	VarFloat("ambient_g", 0.70)
	VarFloat("ambient_b", 0.70)
	VarFloat("ambient_a", 0.30)

	VarFloat("dyncubemap_skycolor_r", 0.14)
	VarFloat("dyncubemap_skycolor_g", 0.24)
	VarFloat("dyncubemap_skycolor_b", 0.56)
	VarFloat("dyncubemap_skycolor_a", 1.00)
	VarFloat("dyncubemap_daycolor_r", 1.00)
	VarFloat("dyncubemap_daycolor_g", 0.95)
	VarFloat("dyncubemap_daycolor_b", 0.85)
	VarFloat("dyncubemap_daycolor_a", 0.00)
	VarFloat("dyncubemap_fogcolor_r", 0.68)
	VarFloat("dyncubemap_fogcolor_g", 0.78)
	VarFloat("dyncubemap_fogcolor_b", 0.82)
	VarFloat("dyncubemap_fogcolor_a", 1.00)
	VarFloat("dyncubemap_ambient_r", 0.70)
	VarFloat("dyncubemap_ambient_g", 0.70)
	VarFloat("dyncubemap_ambient_b", 0.70)
	VarFloat("dyncubemap_ambient_a", 0.30)

	// Dirt color
	VarFloat("dirtcolor_r", 0.14)
	VarFloat("dirtcolor_g", 0.07)
	VarFloat("dirtcolor_b", 0.008)


	// Dirt type
	VarFloat("dirtsnow", 0.0)
	VarFloat("dirtgravel", 0.0)
	VarFloat("dirtmud", 1.0)


	//Nasilenie deszczu - wartoœæ mno¿ona przez m_iRainDropsNumber
	VarRain( 0.0)
	VarSun(1.0)

	VarFloat("sunvisibility", 1.00)
	VarFloat("moonvisibility", 0.00)

    VarString("cloudstexture", "Clouds.dds")
    
    VarInt("CarNightLights", 1)
		VarLightColor(1.0, 1.0, 1.0)

}

