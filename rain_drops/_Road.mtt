$SPECPOW(f, 3)

shader()
{// wet roads, ps2
	SurfaceID(SRFTYPE)
	Shaderquality(4)
    Cull("cw")
    pass()
    {
        Vertexshader("RoadWet.vsh")
        Pixelshader("RoadWet20.psh")

        tmu()
        {
            texture()
            {
                Image(%colortexture)
                addressfunc("clamp", "clamp", "clamp")
            }
        }
        tmu()
        {
            texture()
            {
                Image(%detail1texture)
            }
        }
        tmu()
        {
            texture()
            {
                Image(%detail2texture)
            }
        }
        tmu()
        {
            texture()
            {
                Image(%colortexturesmall)
                addressfunc("clamp", "clamp", "clamp")
            }
        }
        !include("__Clouds.mtt")
        !include("__Tex1.mtt")
        tmu()
        {
            texture()
            {
                Image("PuddleNoise.dds")
            }
        }
    }

    lightpass()
    !include("SpotShadowMapVS.mtt")
    !include("SpotTerrainVS.mtt")
}

shader()
{// >= gffx
	SurfaceID(SRFTYPE)
	Shaderquality(3)
    Cull("cw")
    pass()
    {
        Lighting()
        Pixelshader("Road14.psh")

        !include("__TerrainColormap.mtt")
        !include("__TerrainDetail1.mtt")
        !include("__TerrainDetail2.mtt")
        !include("__TerrainColormapSmall.mtt")
        !include("__Clouds.mtt")
        !include("__Tex1.mtt")

        AmbientColor(0, 0, 0, 1.000)
		DiffuseColor(0, 0, 0, 1.000)
		SpecularColor(1.000, 1.000, 1.000, 1.000)
		EmissiveColor(0.000, 0.000, 0.000, 1.000)
		SpecularPow(SPECPOW)
    }

    lightpass()
    !include("SpotShadowmap.mtt")
    !include("SpotRoad14.mtt")
}

